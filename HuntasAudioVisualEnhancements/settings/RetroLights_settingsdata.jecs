HuntasAudioVisualEnhancements.DisplayEffect.Enable:
    Page: Graphics
    Heading: Retro_Lights
HuntasAudioVisualEnhancements.DisplayEffect.EnableSound:
    Page: Graphics
    Heading: Retro_Lights

HuntasAudioVisualEnhancements.DisplayEffect.DisplayIntensity:
    Page: Graphics
    Heading: Retro_Lights
    Min: 0
    Max: 100
    SliderInterval: 0.1
    DecimalPlacesToDisplay: 1
    PerformanceImpact: Low
    Controls:
        ToggleControls:
            - HuntasAudioVisualEnhancements.DisplayEffect.Enable
    
HuntasAudioVisualEnhancements.DisplayEffect.RampOnSpeed:
    Page: Graphics
    Heading: Retro_Lights
    Min: 0
    Max: 100
    SliderInterval: 0.1
    DecimalPlacesToDisplay: 1
    PerformanceImpact: Low
    Controls:
        ToggleControls:
            - HuntasAudioVisualEnhancements.DisplayEffect.Enable
    
HuntasAudioVisualEnhancements.DisplayEffect.RampOffSpeed:
    Page: Graphics
    Heading: Retro_Lights
    Min: 0
    Max: 100
    SliderInterval: 0.1
    DecimalPlacesToDisplay: 1
    PerformanceImpact: Low
    Controls:
        ToggleControls:
            - HuntasAudioVisualEnhancements.DisplayEffect.Enable
    
